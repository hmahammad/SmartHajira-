rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidCompany(data) {
      return data.nameBangla is string && data.nameBangla.size() <= 200 &&
             data.code is string && data.code.size() <= 50;
    }

    function isValidMember(data) {
      return data.nameBangla is string && data.nameBangla.size() <= 200 &&
             data.roll is string && data.roll.size() <= 50;
    }

    function isValidAttendance(data) {
      return data.studentId is string && data.studentId.size() <= 128 &&
             data.date is string && data.date.size() <= 20 &&
             data.status in ['Present', 'Absent', 'Late'];
    }

    function isValidAuditLog(data) {
      return data.action is string && data.action.size() <= 100 &&
             data.details is string && data.details.size() <= 500;
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if true;
      allow create, update: if isValidId(companyId) && isValidCompany(request.resource.data);
      allow delete: if true;
    }

    // Members / Students Collection
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if isValidId(memberId) && isValidMember(request.resource.data);
      allow delete: if true;
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update: if isValidId(attendanceId) && isValidAttendance(request.resource.data);
      allow delete: if true;
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    // Organization & Schedule Settings Collection
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
